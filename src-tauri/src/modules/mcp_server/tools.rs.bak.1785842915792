//! Read-only tool registry for the MCP server.
//!
//! Safety model: every tool is read-only and resolves paths inside the
//! workspace root (canonicalized prefix check — no `../` escapes). Write
//! operations are intentionally NOT exposed (MCP has no approval channel).

use std::path::{Path, PathBuf};

use serde_json::{json, Value};

use crate::modules::fs;

const MAX_READ_BYTES: u64 = 10 * 1024 * 1024;
const MAX_GREP_HITS: usize = 200;
const MAX_GLOB_MATCHES: usize = 500;

pub struct ToolDef {
    pub name: &'static str,
    pub description: &'static str,
    pub schema: Value,
    pub execute: fn(&Path, &Value) -> Result<Value, String>,
}

pub fn all_tools() -> Vec<ToolDef> {
    vec![
        ToolDef {
            name: "read_file",
            description: "Read a UTF-8 text file inside the workspace (max 10 MiB).",
            schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string", "description": "Absolute or workspace-relative path." } },
                "required": ["path"],
            }),
            execute: read_file,
        },
        ToolDef {
            name: "list_directory",
            description: "List entries of a directory inside the workspace.",
            schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string", "description": "Directory path (default: workspace root)." } },
            }),
            execute: list_directory,
        },
        ToolDef {
            name: "grep",
            description: "Case-insensitive substring search over workspace files (excludes .git).",
            schema: json!({
                "type": "object",
                "properties": {
                    "pattern": { "type": "string" },
                    "path": { "type": "string", "description": "Subdirectory to search (default: workspace root)." },
                    "case_insensitive": { "type": "boolean", "description": "Default true." },
                },
                "required": ["pattern"],
            }),
            execute: grep,
        },
        ToolDef {
            name: "glob",
            description: "Find workspace files matching a glob pattern (excludes .git).",
            schema: json!({
                "type": "object",
                "properties": {
                    "pattern": { "type": "string", "description": "Glob relative to the workspace, e.g. src/**/*.rs." },
                    "path": { "type": "string", "description": "Subdirectory to search (default: workspace root)." },
                },
                "required": ["pattern"],
            }),
            execute: glob,
        },
        ToolDef {
            name: "git_status",
            description: "Read `git status --porcelain` of the workspace.",
            schema: json!({ "type": "object", "properties": {} }),
            execute: git_status,
        },
        ToolDef {
            name: "git_diff",
            description: "Read the working-tree git diff (optionally for one file).",
            schema: json!({
                "type": "object",
                "properties": { "path": { "type": "string", "description": "Optional single-file path." } },
            }),
            execute: git_diff,
        },
    ]
}

/// Resolve a user-supplied path inside `root`; refuse anything that escapes.
pub fn resolve_within(root: &Path, raw: &str) -> Result<PathBuf, String> {
    let root_canon = root
        .canonicalize()
        .map_err(|e| format!("workspace not accessible: {e}"))?;
    let p = Path::new(raw);
    let abs = if p.is_absolute() {
        p.to_path_buf()
    } else {
        root_canon.join(p)
    };
    let canon = abs
        .canonicalize()
        .map_err(|e| format!("path not accessible: {e}"))?;
    if canon.starts_with(&root_canon) {
        Ok(canon)
    } else {
        Err("path escapes the workspace root".into())
    }
}

fn read_file(root: &Path, params: &Value) -> Result<Value, String> {
    let path = params
        .get("path")
        .and_then(Value::as_str)
        .ok_or_else(|| "missing path".to_string())?;
    let canon = resolve_within(root, path)?;
    let meta = std::fs::metadata(&canon).map_err(|e| format!("stat failed: {e}"))?;
    if meta.len() > MAX_READ_BYTES {
        return Err(format!(
            "file too large ({} bytes, limit {MAX_READ_BYTES})",
            meta.len()
        ));
    }
    let bytes = std::fs::read(&canon).map_err(|e| format!("read failed: {e}"))?;
    if bytes.iter().take(8192).any(|b| *b == 0) {
        return Err("binary file".into());
    }
    Ok(json!({
        "path": fs::to_canon(&canon),
        "content": String::from_utf8_lossy(&bytes).into_owned(),
        "size": bytes.len(),
    }))
}

fn list_directory(root: &Path, params: &Value) -> Result<Value, String> {
    let path = params
        .get("path")
        .and_then(Value::as_str)
        .unwrap_or(".");
    let canon = resolve_within(root, path)?;
    let entries: Vec<Value> = std::fs::read_dir(&canon)
        .map_err(|e| format!("read_dir failed: {e}"))?
        .filter_map(|e| e.ok())
        .map(|e| {
            let kind = e.file_type().ok();
            json!({
                "name": e.file_name().to_string_lossy().into_owned(),
                "kind": if kind.as_ref().is_some_and(|k| k.is_dir()) { "dir" }
                        else if kind.as_ref().is_some_and(|k| k.is_symlink()) { "symlink" }
                        else { "file" },
            })
        })
        .collect();
    Ok(json!({ "path": fs::to_canon(&canon), "entries": entries }))
}

fn grep(root: &Path, params: &Value) -> Result<Value, String> {
    let pattern = params
        .get("pattern")
        .and_then(Value::as_str)
        .ok_or_else(|| "missing pattern".to_string())?;
    let case_insensitive = params
        .get("case_insensitive")
        .and_then(Value::as_bool)
        .unwrap_or(true);
    let dir = match params.get("path") {
        Some(Value::String(p)) if !p.is_empty() => resolve_within(root, p)?,
        _ => root.to_path_buf(),
    };
    let needle = if case_insensitive {
        pattern.to_lowercase()
    } else {
        pattern.to_string()
    };

    let mut hits = Vec::new();
    let walker = ignore::WalkBuilder::new(&dir)
        .hidden(false)
        .git_ignore(true)
        .filter_entry(|e| e.file_name() != ".git")
        .build();
    'outer: for entry in walker {
        let Ok(entry) = entry else { continue };
        if !entry.file_type().is_some_and(|t| t.is_file()) {
            continue;
        }
        let Ok(content) = std::fs::read_to_string(entry.path()) else {
            continue;
        };
        for (i, line) in content.lines().enumerate() {
            let hay = if case_insensitive {
                line.to_lowercase()
            } else {
                line.to_string()
            };
            if hay.contains(&needle) {
                let rel = entry
                    .path()
                    .strip_prefix(root)
                    .map(|p| p.to_string_lossy().into_owned())
                    .unwrap_or_else(|_| entry.path().to_string_lossy().into_owned());
                hits.push(json!({ "path": rel, "line": i + 1, "text": line }));
                if hits.len() >= MAX_GREP_HITS {
                    break 'outer;
                }
            }
        }
    }
    Ok(json!({ "hits": hits, "truncated": hits.len() >= MAX_GREP_HITS }))
}

fn glob(root: &Path, params: &Value) -> Result<Value, String> {
    let pattern = params
        .get("pattern")
        .and_then(Value::as_str)
        .ok_or_else(|| "missing pattern".to_string())?;
    let matcher = globset::Glob::new(pattern)
        .map_err(|e| format!("bad glob: {e}"))?
        .compile_matcher();
    let dir = match params.get("path") {
        Some(Value::String(p)) if !p.is_empty() => resolve_within(root, p)?,
        _ => root.to_path_buf(),
    };

    let mut matches = Vec::new();
    let walker = ignore::WalkBuilder::new(&dir)
        .hidden(false)
        .git_ignore(true)
        .filter_entry(|e| e.file_name() != ".git")
        .build();
    for entry in walker {
        let Ok(entry) = entry else { continue };
        if !entry.file_type().is_some_and(|t| t.is_file()) {
            continue;
        }
        let rel = entry
            .path()
            .strip_prefix(root)
            .map(|p| p.to_string_lossy().into_owned())
            .unwrap_or_default();
        if matcher.is_match(&rel) {
            matches.push(rel);
            if matches.len() >= MAX_GLOB_MATCHES {
                break;
            }
        }
    }
    Ok(json!({ "matches": matches, "truncated": matches.len() >= MAX_GLOB_MATCHES }))
}

fn git_status(root: &Path, _params: &Value) -> Result<Value, String> {
    let out = run_git(root, &["status".to_string(), "--porcelain".to_string()])?;
    let lines: Vec<String> = out.lines().map(str::to_string).filter(|l| !l.is_empty()).collect();
    Ok(json!({ "status": lines }))
}

fn git_diff(root: &Path, params: &Value) -> Result<Value, String> {
    let mut args = vec!["diff".to_string()];
    if let Some(Value::String(p)) = params.get("path") {
        let canon = resolve_within(root, p)?;
        args.push(canon.to_string_lossy().into_owned());
    }
    Ok(json!({ "diff": run_git(root, &args)? }))
}

fn run_git(root: &Path, args: &[String]) -> Result<String, String> {
    let out = std::process::Command::new("git")
        .current_dir(root)
        .args(args)
        .output()
        .map_err(|e| format!("git failed: {e}"))?;
    if !out.status.success() {
        let err = String::from_utf8_lossy(&out.stderr).trim().to_string();
        return Err(if err.is_empty() {
            "git command failed".into()
        } else {
            err
        });
    }
    Ok(String::from_utf8_lossy(&out.stdout).into_owned())
}

#[cfg(test)]
mod tests {
    use super::*;
    use std::fs;
    use tempfile::TempDir;

    fn root() -> TempDir {
        TempDir::new().expect("tempdir")
    }

    #[test]
    fn resolve_within_accepts_inside_and_rejects_escape() {
        let tmp = root();
        fs::write(tmp.path().join("a.txt"), "hi").unwrap();
        fs::create_dir_all(tmp.path().join("sub")).unwrap();

        let inside = resolve_within(tmp.path(), "a.txt").unwrap();
        assert_eq!(inside.file_name().unwrap().to_string_lossy(), "a.txt");
        let inside_abs = resolve_within(tmp.path(), &tmp.path().join("a.txt").to_string_lossy()).unwrap();
        assert!(inside_abs.exists());

        // Parent escape: a sibling of the workspace.
        let outside = tmp.path().parent().unwrap();
        assert!(resolve_within(tmp.path(), &format!("../{}", outside.file_name().unwrap().to_string_lossy())).is_err());
        // Missing path is also refused (canonicalize fails).
        assert!(resolve_within(tmp.path(), "nope.txt").is_err());
    }

    #[test]
    fn read_file_returns_content_and_refuses_binary() {
        let tmp = root();
        fs::write(tmp.path().join("f.txt"), "hello\n").unwrap();
        let res = read_file(tmp.path(), &json!({ "path": "f.txt" })).unwrap();
        assert_eq!(res["content"], "hello\n");

        fs::write(tmp.path().join("bin.dat"), [0u8, 1, 2, 0]).unwrap();
        assert!(read_file(tmp.path(), &json!({ "path": "bin.dat" })).is_err());
        assert!(read_file(tmp.path(), &json!({})).is_err());
    }

    #[test]
    fn list_directory_lists_entries() {
        let tmp = root();
        fs::write(tmp.path().join("a.txt"), "").unwrap();
        fs::create_dir(tmp.path().join("d")).unwrap();
        let res = list_directory(tmp.path(), &json!({})).unwrap();
        let names: Vec<&str> = res["entries"]
            .as_array()
            .unwrap()
            .iter()
            .map(|e| e["name"].as_str().unwrap())
            .collect();
        assert!(names.contains(&"a.txt"));
        assert!(names.contains(&"d"));
    }

    #[test]
    fn grep_finds_hits_and_skips_git() {
        let tmp = root();
        fs::write(tmp.path().join("src.rs"), "fn main() { println!(\"hello\"); }\n").unwrap();
        fs::create_dir_all(tmp.path().join(".git")).unwrap();
        fs::write(tmp.path().join(".git/config"), "hello\n").unwrap();
        fs::write(tmp.path().join("other.txt"), "no match here\n").unwrap();

        let res = grep(tmp.path(), &json!({ "pattern": "hello" })).unwrap();
        let hits = res["hits"].as_array().unwrap();
        assert_eq!(hits.len(), 1);
        assert_eq!(hits[0]["path"], "src.rs");
        assert_eq!(hits[0]["line"], 1);
    }

    #[test]
    fn glob_matches_patterns() {
        let tmp = root();
        fs::write(tmp.path().join("a.rs"), "").unwrap();
        fs::write(tmp.path().join("b.ts"), "").unwrap();
        fs::create_dir_all(tmp.path().join(".git")).unwrap();
        fs::write(tmp.path().join(".git/x.rs"), "").unwrap();

        let res = glob(tmp.path(), &json!({ "pattern": "**/*.rs" })).unwrap();
        let matches = res["matches"].as_array().unwrap();
        let strs: Vec<&str> = matches.iter().map(|m| m.as_str().unwrap()).collect();
        assert_eq!(strs, vec!["a.rs"]);
        assert!(glob(tmp.path(), &json!({ "pattern": "[" })).is_err());
    }

    #[test]
    fn tool_registry_has_six_readonly_tools() {
        let tools = all_tools();
        assert_eq!(tools.len(), 6);
        let names: Vec<&str> = tools.iter().map(|t| t.name).collect();
        for expected in ["read_file", "list_directory", "grep", "glob", "git_status", "git_diff"] {
            assert!(names.contains(&expected));
        }
    }
}
