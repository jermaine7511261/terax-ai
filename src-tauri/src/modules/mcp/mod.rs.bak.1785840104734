//! MCP client — connect external MCP servers (stdio / HTTP) and surface their
//! tools through the AI tool surface.
//!
//! Safety: every MCP tool is treated as untrusted — the frontend wraps them
//! with `needsApproval: true`, and results are redacted there. This module
//! only owns the transport + JSON-RPC protocol; it never auto-executes tools.

mod client;

use std::collections::HashMap;
use std::sync::{Arc, RwLock};

use serde::Deserialize;
use serde_json::Value;
use tauri::State;
use tokio::sync::Mutex;

pub use client::{McpClient, McpServerStatus, McpToolInfo};

/// Connection config for one MCP server, supplied by the settings UI.
#[derive(Clone, Debug, Deserialize)]
pub struct ServerConfig {
    pub id: String,
    pub name: String,
    /// "stdio" | "http"
    pub transport: String,
    pub command: Option<String>,
    pub args: Option<Vec<String>>,
    pub cwd: Option<String>,
    pub env: Option<HashMap<String, String>>,
    pub url: Option<String>,
    pub headers: Option<HashMap<String, String>>,
}

#[derive(Default)]
pub struct McpState(pub RwLock<HashMap<String, Arc<Mutex<McpClient>>>>);

fn validate_config(config: &ServerConfig) -> Result<(), String> {
    if config.id.trim().is_empty() || config.name.trim().is_empty() {
        return Err("mcp server requires a name and id".into());
    }
    match config.transport.as_str() {
        "stdio" => {
            let cmd = config.command.as_deref().unwrap_or("");
            if cmd.trim().is_empty() {
                return Err("stdio transport requires a command".into());
            }
            client::validate_command(cmd)?;
        }
        "http" => {
            let url = config.url.as_deref().unwrap_or("");
            if url.trim().is_empty() {
                return Err("http transport requires a url".into());
            }
        }
        other => return Err(format!("unsupported transport: {other}")),
    }
    Ok(())
}

/// Connect (or reconnect) to an MCP server and complete the handshake, caching
/// its tool list. Idempotent: an already-connected server is returned as-is.
#[tauri::command]
pub async fn mcp_connect(
    state: State<'_, McpState>,
    config: ServerConfig,
) -> Result<(), String> {
    validate_config(&config)?;

    {
        let reg = state.0.read().map_err(|e| e.to_string())?;
        if reg.contains_key(&config.id) {
            return Ok(());
        }
    }

    let client = Arc::new(Mutex::new(McpClient::new(config)));
    client.lock().await.connect().await?;

    let id = client.lock().await.id().to_string();
    state.0.write().map_err(|e| e.to_string())?.insert(id, client);
    Ok(())
}

/// All tools from every connected MCP server (schema included), for the
/// frontend to rebuild its dynamic tool surface.
#[tauri::command]
pub async fn mcp_tools_list(state: State<'_, McpState>) -> Result<Vec<McpToolInfo>, String> {
    let clients = collect_clients(&state)?;
    let mut out = Vec::new();
    for client in clients {
        out.extend(client.lock().await.tools().await);
    }
    Ok(out)
}

/// Forward a `tools/call` to the owning server. `args` is the raw JSON object
/// the model produced (already zod-validated by the frontend tool wrapper).
#[tauri::command]
pub async fn mcp_call(
    state: State<'_, McpState>,
    client_id: String,
    tool: String,
    args: Value,
) -> Result<Value, String> {
    let client = find_client(&state, &client_id)?;
    let result = client.lock().await.call(&tool, args).await;
    result
}

/// Kill the child process / drop the session and unregister the server.
#[tauri::command]
pub async fn mcp_disconnect(state: State<'_, McpState>, client_id: String) -> Result<(), String> {
    let removed = state
        .0
        .write()
        .map_err(|e| e.to_string())?
        .remove(&client_id);
    if let Some(client) = removed {
        client.lock().await.shutdown();
    }
    Ok(())
}

/// Per-server connection state + tool count for the settings page.
#[tauri::command]
pub async fn mcp_status(state: State<'_, McpState>) -> Result<Vec<McpServerStatus>, String> {
    let clients = collect_clients(&state)?;
    let mut out = Vec::with_capacity(clients.len());
    for client in clients {
        out.push(client.lock().await.status());
    }
    out.sort_by(|a, b| a.name.cmp(&b.name));
    Ok(out)
}

fn collect_clients(state: &State<'_, McpState>) -> Result<Vec<Arc<Mutex<McpClient>>>, String> {
    let reg = state.0.read().map_err(|e| e.to_string())?;
    Ok(reg.values().cloned().collect())
}

fn find_client(
    state: &State<'_, McpState>,
    client_id: &str,
) -> Result<Arc<Mutex<McpClient>>, String> {
    let reg = state.0.read().map_err(|e| e.to_string())?;
    reg.get(client_id).cloned().ok_or_else(|| {
        format!("mcp server not connected: {client_id} (connect it in Settings → Skills / MCP)")
    })
}

#[cfg(test)]
mod tests {
    use super::*;

    fn cfg(transport: &str, command: Option<&str>, url: Option<&str>) -> ServerConfig {
        ServerConfig {
            id: "s1".into(),
            name: "s1".into(),
            transport: transport.into(),
            command: command.map(str::to_string),
            args: None,
            cwd: None,
            env: None,
            url: url.map(str::to_string),
            headers: None,
        }
    }

    #[test]
    fn validate_stdio_requires_command() {
        assert!(validate_config(&cfg("stdio", None, None)).is_err());
        assert!(validate_config(&cfg("stdio", Some("npx"), None)).is_ok());
    }

    #[test]
    fn validate_http_requires_url() {
        assert!(validate_config(&cfg("http", None, None)).is_err());
        assert!(validate_config(&cfg("http", None, Some("https://x/mcp"))).is_ok());
    }

    #[test]
    fn validate_rejects_unknown_transport_and_control_chars() {
        assert!(validate_config(&cfg("ssh", Some("npx"), None)).is_err());
        let mut c = cfg("stdio", Some("npx"), None);
        c.command = Some("npx\x1b".into());
        assert!(validate_config(&c).is_err());
    }
}
