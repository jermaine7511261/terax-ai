//! `McpClient` — the transport + JSON-RPC half of the MCP client.
//!
//! Two transports:
//!  - **stdio**: a child process speaking newline-delimited JSON-RPC 2.0 on
//!    stdin/stdout (the Claude Code / LangBot standard shape). The child is
//!    spawned hidden (no console window), joined to a Windows Job Object so
//!    dropping the client kills the whole process tree, and restarted on
//!    demand up to `MAX_RECONNECTS` times with backoff.
//!  - **http**: Streamable-HTTP style POSTs via `net::ai_http_request`, which
//!    reuses the existing SSRF guard (local/remote both allowed, logged).

use std::collections::HashMap;
use std::sync::atomic::{AtomicU64, Ordering};
use std::sync::Arc;
use std::time::Duration;

use serde::Serialize;
use serde_json::{json, Value};
use tokio::io::{AsyncBufReadExt, AsyncWriteExt, BufReader};
use tokio::process::{Child, ChildStdin, Command};
use tokio::sync::{oneshot, Mutex, OwnedSemaphorePermit, Semaphore};
use tokio::time::timeout;

use super::ServerConfig;
use crate::modules::net;

const INIT_TIMEOUT: Duration = Duration::from_secs(60);
const CALL_TIMEOUT: Duration = Duration::from_secs(120);
const MAX_OUTPUT_BYTES: usize = 32 * 1024 * 1024;
const STDERR_TAIL_BYTES: usize = 8 * 1024;
const MAX_RECONNECTS: u32 = 3;
const RECONNECT_BACKOFF: Duration = Duration::from_millis(500);
const MAX_CONCURRENT_CALLS: usize = 4;
const MCP_PROTOCOL_VERSION: &str = "2025-03-26";

#[derive(Clone, Serialize)]
pub struct McpToolInfo {
    pub server_id: String,
    pub server_name: String,
    pub name: String,
    pub description: String,
    pub input_schema: Value,
}

#[derive(Serialize)]
pub struct McpServerStatus {
    pub id: String,
    pub name: String,
    pub connected: bool,
    pub tool_count: usize,
    pub stderr_tail: String,
    pub error: Option<String>,
}

/// Reject control characters (incl. newlines that would smuggle a second
/// JSON-RPC message) and shell metacharacter prefixes in a stdio command.
pub fn validate_command(cmd: &str) -> Result<(), String> {
    if cmd.trim().is_empty() {
        return Err("empty mcp command".into());
    }
    if cmd.chars().any(|c| c.is_control()) {
        return Err("mcp command contains control characters".into());
    }
    let trimmed = cmd.trim_start();
    for prefix in [";", "|", "&&", "||", "`", "$("] {
        if trimmed.starts_with(prefix) {
            return Err(format!("mcp command must not start with {prefix:?}"));
        }
    }
    Ok(())
}

/// Append `text` to a byte-capped ring tail, dropping from the front when the
/// cap is exceeded. Keeps the newest content (stderr tail for error UIs).
fn push_tail(buf: &mut String, text: &str, max: usize) {
    buf.push_str(text);
    if buf.len() <= max {
        return;
    }
    let excess = buf.len() - max;
    let mut cut = excess;
    while cut < buf.len() && !buf.is_char_boundary(cut) {
        cut += 1;
    }
    buf.drain(..cut);
}

/// Minimal SSE parser: return the JSON payload of the first `data:` line.
/// MCP servers may respond to a POST with either a plain JSON body or an
/// SSE stream containing one JSON-RPC message.
fn parse_sse(body: &str) -> Result<Value, String> {
    for line in body.lines() {
        if let Some(data) = line.strip_prefix("data:") {
            let data = data.trim();
            if data.is_empty() {
                continue;
            }
            if data == "[DONE]" {
                break;
            }
            return serde_json::from_str(data).map_err(|e| format!("bad SSE json: {e}"));
        }
    }
    Err("no data event in SSE response".into())
}

fn build_request(id: u64, method: &str, params: Value) -> Value {
    json!({ "jsonrpc": "2.0", "id": id, "method": method, "params": params })
}

/// Parse a JSON-RPC 2.0 response line into (id, result-or-error).
fn parse_response(line: &str) -> Result<(u64, Result<Value, String>), String> {
    let v: Value = serde_json::from_str(line).map_err(|e| format!("bad jsonrpc line: {e}"))?;
    let id = v
        .get("id")
        .and_then(Value::as_u64)
        .ok_or_else(|| "jsonrpc response missing numeric id".to_string())?;
    if let Some(err) = v.get("error") {
        let msg = err
            .get("message")
            .and_then(Value::as_str)
            .unwrap_or("mcp error")
            .to_string();
        return Ok((id, Err(msg)));
    }
    let result = v.get("result").cloned().unwrap_or(Value::Null);
    Ok((id, Ok(result)))
}

type Pending = Arc<Mutex<HashMap<u64, oneshot::Sender<Result<Value, String>>>>>;

struct StdioRuntime {
    child: Option<Child>,
    stdin: Option<ChildStdin>,
    stderr_tail: Arc<Mutex<String>>,
    /// Set when the child has exited (reader task noticed EOF).
    exited: bool,
    reconnect_attempts: u32,
    /// Windows Job Object; dropping it kills the whole child process tree.
    #[cfg(windows)]
    job: Option<crate::modules::proc::job::ProcessJob>,
}

enum Transport {
    // Box keeps the enum small: StdioRuntime carries child + pipes (~360B).
    Stdio(Box<StdioRuntime>),
    Http {
        url: String,
        headers: HashMap<String, String>,
        session_id: Option<String>,
        connected: bool,
        error: Option<String>,
    },
}

pub struct McpClient {
    config: ServerConfig,
    pending: Pending,
    next_id: AtomicU64,
    semaphore: Arc<Semaphore>,
    tools: Arc<Mutex<Vec<McpToolInfo>>>,
    transport: Mutex<Transport>,
}

impl McpClient {
    pub fn new(config: ServerConfig) -> Self {
        let transport = match config.transport.as_str() {
            "http" => Transport::Http {
                url: config.url.clone().unwrap_or_default(),
                headers: config.headers.clone().unwrap_or_default(),
                session_id: None,
                connected: false,
                error: None,
            },
            _ => Transport::Stdio(Box::new(StdioRuntime {
                child: None,
                stdin: None,
                stderr_tail: Arc::new(Mutex::new(String::new())),
                exited: false,
                reconnect_attempts: 0,
                #[cfg(windows)]
                job: None,
            }),
        };
        Self {
            config,
            pending: Arc::new(Mutex::new(HashMap::new())),
            next_id: AtomicU64::new(1),
            semaphore: Arc::new(Semaphore::new(MAX_CONCURRENT_CALLS)),
            tools: Arc::new(Mutex::new(Vec::new())),
            transport: Mutex::new(transport),
        }
    }

    pub fn id(&self) -> &str {
        &self.config.id
    }

    pub async fn tools(&self) -> Vec<McpToolInfo> {
        self.tools.lock().await.clone()
    }

    pub async fn status(&self) -> McpServerStatus {
        let transport = self.transport.lock().await;
        let tool_count = self.tools.lock().await.len();
        let (connected, stderr_tail, error) = match &*transport {
            Transport::Stdio(s) => (
                !s.exited && s.child.is_some(),
                s.stderr_tail.lock().await.clone(),
                None,
            ),
            Transport::Http {
                connected, error, ..
            } => (*connected, String::new(), error.clone()),
        };
        McpServerStatus {
            id: self.config.id.clone(),
            name: self.config.name.clone(),
            connected,
            tool_count,
            stderr_tail,
            error,
        }
    }

    /// Establish the connection (spawn child) and run the
    /// `initialize` / `notifications/initialized` / `tools/list` handshake.
    pub async fn connect(&mut self) -> Result<(), String> {
        if let Transport::Stdio(rt) = &mut *self.transport.lock().await {
            self.spawn_stdio(rt).await?;
        }
        let init = self
            .request(
                "initialize",
                json!({
                    "protocolVersion": MCP_PROTOCOL_VERSION,
                    "capabilities": {},
                    "clientInfo": { "name": "yamet", "version": env!("CARGO_PKG_VERSION") },
                }),
                INIT_TIMEOUT,
            )
            .await?;
        if let Some(server) = init.get("serverInfo") {
            log::info!("mcp {}: server {:?}", self.config.name, server);
        }

        // Notification (no response expected).
        self.notify("notifications/initialized", json!({})).await?;

        let list = self.request("tools/list", json!({}), INIT_TIMEOUT).await?;
        *self.tools.lock().await = parse_tools(&self.config, &list);
        Ok(())
    }

    /// Forward a `tools/call` to the server. Concurrent calls are capped at
    /// `MAX_CONCURRENT_CALLS`; a dead stdio child is restarted (≤
    /// `MAX_RECONNECTS`, with backoff) before the call is sent.
    pub async fn call(&self, tool: &str, args: Value) -> Result<Value, String> {
        let _permit: OwnedSemaphorePermit = self
            .semaphore
            .clone()
            .acquire_owned()
            .await
            .map_err(|e| e.to_string())?;
        self.ensure_alive().await?;
        let params = json!({ "name": tool, "arguments": args });
        self.request("tools/call", params, CALL_TIMEOUT).await
    }

    pub async fn shutdown(&self) {
        let mut transport = self.transport.lock().await;
        match &mut *transport {
            Transport::Stdio(rt) => {
                if let Some(child) = rt.child.as_mut() {
                    let _ = child.kill().await;
                    let _ = child.wait().await;
                }
                rt.child = None;
                rt.stdin = None;
                rt.exited = true;
                #[cfg(windows)]
                {
                    rt.job = None; // dropping the job kills the tree
                }
            }
            Transport::Http { connected, .. } => {
                *connected = false;
            }
        }
        self.pending.lock().await.clear();
    }

    /// (Re)spawn a dead stdio child so the next request can be sent.
    async fn ensure_alive(&self) -> Result<(), String> {
        let mut transport = self.transport.lock().await;
        match &mut *transport {
            Transport::Http { connected, .. } => {
                // Http is request/response per POST; mark connected on first use.
                *connected = true;
                Ok(())
            }
            Transport::Stdio(rt) => {
                if rt.child.is_some() && !rt.exited {
                    return Ok(());
                }
                if rt.reconnect_attempts >= MAX_RECONNECTS {
                    return Err("server disconnected: reconnect limit reached".into());
                }
                rt.reconnect_attempts += 1;
                drop(transport);
                tokio::time::sleep(RECONNECT_BACKOFF).await;
                {
                    let mut t = self.transport.lock().await;
                    if let Transport::Stdio(rt) = &mut *t {
                        self.spawn_stdio(rt).await?;
                    }
                }
                // Re-run the handshake so tools stay fresh after a restart.
                self.reconnect_handshake().await
            }
        }
    }

    async fn reconnect_handshake(&self) -> Result<(), String> {
        let init = self
            .request(
                "initialize",
                json!({
                    "protocolVersion": MCP_PROTOCOL_VERSION,
                    "capabilities": {},
                    "clientInfo": { "name": "yamet", "version": env!("CARGO_PKG_VERSION") },
                }),
                INIT_TIMEOUT,
            )
            .await?;
        let _ = init;
        self.notify("notifications/initialized", json!({})).await?;
        let list = self.request("tools/list", json!({}), INIT_TIMEOUT).await?;
        *self.tools.lock().await = parse_tools(&self.config, &list);
        Ok(())
    }

    /// JSON-RPC request with `id`, awaiting the matching response (or timeout).
    async fn request(&self, method: &str, params: Value, ttl: Duration) -> Result<Value, String> {
        let id = self.next_id.fetch_add(1, Ordering::Relaxed);
        let body = build_request(id, method, params);
        let (tx, rx) = oneshot::channel();
        self.pending.lock().await.insert(id, tx);

        let is_http = matches!(&*self.transport.lock().await, Transport::Http { .. });
        if is_http {
            self.http_post(&body).await?;
        } else {
            let mut transport = self.transport.lock().await;
            let Transport::Stdio(rt) = &mut *transport else {
                return Err("internal: transport changed".into());
            };
            let stdin = rt.stdin.as_mut().ok_or("stdio stdin closed")?;
            stdin
                .write_all((body.to_string() + "\n").as_bytes())
                .await
                .map_err(|e| format!("stdio write failed: {e}"))?;
            stdin
                .flush()
                .await
                .map_err(|e| format!("stdio flush failed: {e}"))?;
            drop(transport);
        }

        match timeout(ttl, rx).await {
            Ok(Ok(Ok(v))) => Ok(v),
            Ok(Ok(Err(e))) => Err(e),
            Ok(Err(_)) => {
                self.pending.lock().await.remove(&id);
                Err(format!("mcp request failed: {method}"))
            }
            Err(_) => {
                self.pending.lock().await.remove(&id);
                Err(format!("mcp request timed out: {method}"))
            }
        }
    }

    /// Fire-and-forget JSON-RPC notification (no `id`, no response).
    async fn notify(&self, method: &str, params: Value) -> Result<(), String> {
        let body = json!({ "jsonrpc": "2.0", "method": method, "params": params });
        let is_http = matches!(&*self.transport.lock().await, Transport::Http { .. });
        if is_http {
            let _ = self.http_post(&body).await; // no response expected; ignore
            return Ok(());
        }
        let mut transport = self.transport.lock().await;
        let Transport::Stdio(rt) = &mut *transport else {
            return Err("internal: transport changed".into());
        };
        let stdin = rt.stdin.as_mut().ok_or("stdio stdin closed")?;
        stdin
            .write_all((body.to_string() + "\n").as_bytes())
            .await
            .map_err(|e| format!("stdio write failed: {e}"))?;
        stdin
            .flush()
            .await
            .map_err(|e| format!("stdio flush failed: {e}"))
    }

    /// One Streamable-HTTP POST: send the JSON-RPC body, parse the JSON (or
    /// SSE) response, capture a session id header, and resolve the pending
    /// request. `net::ai_http_request` performs the SSRF guard.
    async fn http_post(&self, body: &Value) -> Result<(), String> {
        let (url, headers, session_id) = {
            let transport = self.transport.lock().await;
            match &*transport {
                Transport::Http {
                    url,
                    headers,
                    session_id,
                    ..
                } => (url.clone(), headers.clone(), session_id.clone()),
                _ => return Err("not an http transport".into()),
            }
        };
        let mut h = headers;
        h.insert(
            "Accept".to_string(),
            "application/json, text/event-stream".to_string(),
        );
        h.insert("Content-Type".to_string(), "application/json".to_string());
        if let Some(sid) = &session_id {
            h.insert("mcp-session-id".to_string(), sid.clone());
        }
        let resp = net::ai_http_request(
            url,
            "POST".to_string(),
            Some(h),
            Some(body.to_string().into_bytes()),
            Some(true), // allow private (local LLM-style endpoints)
        )
        .await?;

        // Streamable HTTP returns the session id in a response header.
        if let Some(sid) = resp.headers.get("mcp-session-id").cloned() {
            if let Transport::Http { session_id, .. } = &mut *self.transport.lock().await {
                *session_id = Some(sid);
            }
        }

        let ct = resp
            .headers
            .get("content-type")
            .cloned()
            .unwrap_or_default();
        let text = String::from_utf8_lossy(&resp.body).into_owned();
        let value = if ct.contains("text/event-stream") {
            parse_sse(&text)?
        } else {
            serde_json::from_str(text.trim()).map_err(|e| format!("bad http json: {e}"))?
        };
        let id = value
            .get("id")
            .and_then(Value::as_u64)
            .ok_or_else(|| "http response missing id".to_string())?;
        let res = if let Some(err) = value.get("error") {
            Err(err
                .get("message")
                .and_then(Value::as_str)
                .unwrap_or("mcp error")
                .to_string())
        } else {
            Ok(value.get("result").cloned().unwrap_or(Value::Null))
        };
        let mut map = self.pending.lock().await;
        if let Some(tx) = map.remove(&id) {
            let _ = tx.send(res);
        }
        Ok(())
    }

    async fn spawn_stdio(&self, rt: &mut StdioRuntime) -> Result<(), String> {
        let mut cmd = Command::new(self.config.command.clone().unwrap_or_default());
        if let Some(args) = &self.config.args {
            cmd.args(args);
        }
        if let Some(cwd) = &self.config.cwd {
            cmd.current_dir(cwd);
        }
        if let Some(env) = &self.config.env {
            cmd.envs(env);
        }
        cmd.stdin(std::process::Stdio::piped())
            .stdout(std::process::Stdio::piped())
            .stderr(std::process::Stdio::piped())
            .kill_on_drop(true);
        #[cfg(windows)]
        {
            const CREATE_NO_WINDOW: u32 = 0x0800_0000;
            cmd.creation_flags(CREATE_NO_WINDOW);
        }
        #[cfg(unix)]
        {
            cmd.process_group(0);
        }

        let mut child = cmd
            .spawn()
            .map_err(|e| format!("spawn mcp server failed: {e}"))?;

        #[cfg(windows)]
        {
            if let Some(pid) = child.id() {
                rt.job = crate::modules::proc::job::ProcessJob::create_for(pid).ok();
            }
        }

        let stdout = child
            .stdout
            .take()
            .ok_or_else(|| "no stdout from mcp server".to_string())?;
        let stderr = child
            .stderr
            .take()
            .ok_or_else(|| "no stderr from mcp server".to_string())?;
        let stdin = child
            .stdin
            .take()
            .ok_or_else(|| "no stdin to mcp server".to_string())?;

        rt.child = Some(child);
        rt.stdin = Some(stdin);
        rt.exited = false;
        rt.reconnect_attempts = 0;

        let pending = self.pending.clone();
        let stderr_tail = rt.stderr_tail.clone();
        let server_name = self.config.name.clone();

        // Reader task: stdout lines → pending responses.
        let _reader = tokio::spawn(async move {
            let mut reader = BufReader::new(stdout);
            let mut line = String::new();
            loop {
                line.clear();
                match reader.read_line(&mut line).await {
                    Ok(0) | Err(_) => break,
                    Ok(_) => {
                        if line.len() > MAX_OUTPUT_BYTES {
                            log::warn!(
                                "mcp {server_name}: line exceeds {MAX_OUTPUT_BYTES}B, dropping"
                            );
                            continue;
                        }
                        let trimmed = line.trim();
                        if trimmed.is_empty() {
                            continue;
                        }
                        match parse_response(trimmed) {
                            Ok((id, res)) => {
                                let mut map = pending.lock().await;
                                if let Some(tx) = map.remove(&id) {
                                    let _ = tx.send(res);
                                }
                            }
                            Err(e) => log::debug!("mcp {server_name}: {e}"),
                        }
                    }
                }
            }
        });

        // Stderr task: keep a capped tail for error UIs.
        let _stderr_task = tokio::spawn(async move {
            let mut reader = BufReader::new(stderr);
            let mut line = String::new();
            loop {
                line.clear();
                match reader.read_line(&mut line).await {
                    Ok(0) | Err(_) => break,
                    Ok(_) => {
                        push_tail(&mut *stderr_tail.lock().await, &line, STDERR_TAIL_BYTES);
                    }
                }
            }
        });

        Ok(())
    }
}

fn parse_tools(config: &ServerConfig, list: &Value) -> Vec<McpToolInfo> {
    let mut tools = Vec::new();
    if let Some(arr) = list.get("tools").and_then(Value::as_array) {
        for t in arr {
            let name = t.get("name").and_then(Value::as_str).unwrap_or_default();
            if name.is_empty() {
                continue;
            }
            tools.push(McpToolInfo {
                server_id: config.id.clone(),
                server_name: config.name.clone(),
                name: name.to_string(),
                description: t
                    .get("description")
                    .and_then(Value::as_str)
                    .unwrap_or_default()
                    .to_string(),
                input_schema: t.get("inputSchema").cloned().unwrap_or(json!({})),
            });
        }
    }
    tools
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn validate_command_guards() {
        assert!(validate_command("").is_err());
        assert!(validate_command("npx -y @modelcontextprotocol/server-filesystem").is_ok());
        assert!(validate_command("npx\nrm -rf /").is_err());
        assert!(validate_command("; echo hi").is_err());
        assert!(validate_command("| cat").is_err());
        assert!(validate_command("&& ls").is_err());
    }

    #[test]
    fn push_tail_keeps_newest() {
        let mut buf = String::new();
        push_tail(&mut buf, "aaaa", 8);
        push_tail(&mut buf, "bbbb", 8);
        assert_eq!(buf, "aaaabbbb");
        push_tail(&mut buf, "cccc", 8);
        assert_eq!(buf, "bbbbcccc");
        // Multi-byte boundary safety: a cut inside a UTF-8 char must not panic.
        let mut b = String::new();
        push_tail(&mut b, "你好世界", 5);
        assert!(b.is_char_boundary(0) && b.len() <= 5 + 3);
    }

    #[test]
    fn parse_response_result_and_error() {
        let (id, res) = parse_response(r#"{"jsonrpc":"2.0","id":7,"result":{"ok":true}}"#).unwrap();
        assert_eq!(id, 7);
        assert_eq!(res.unwrap().get("ok"), Some(&Value::Bool(true)));

        let (id, res) =
            parse_response(r#"{"jsonrpc":"2.0","id":8,"error":{"code":-32000,"message":"boom"}}"#)
                .unwrap();
        assert_eq!(id, 8);
        assert_eq!(res.unwrap_err(), "boom");
    }

    #[test]
    fn build_request_shape() {
        let v = build_request(3, "tools/call", json!({"name": "x"}));
        assert_eq!(v["jsonrpc"], "2.0");
        assert_eq!(v["id"], 3);
        assert_eq!(v["method"], "tools/call");
    }

    #[test]
    fn parse_sse_extracts_data() {
        let sse = "event: message\ndata: {\"result\":{\"ok\":1}}\n\n";
        let v = parse_sse(sse).unwrap();
        assert_eq!(v["result"]["ok"], 1);
        assert!(parse_sse("event: done\ndata: [DONE]\n\n").is_err());
    }

    #[test]
    fn parse_tools_skips_unnamed() {
        let list = json!({
            "tools": [
                { "name": "a", "description": "A", "inputSchema": { "type": "object" } },
                { "description": "no name" },
            ]
        });
        let cfg = ServerConfig {
            id: "s".into(),
            name: "s".into(),
            transport: "stdio".into(),
            command: None,
            args: None,
            cwd: None,
            env: None,
            url: None,
            headers: None,
        };
        let tools = parse_tools(&cfg, &list);
        assert_eq!(tools.len(), 1);
        assert_eq!(tools[0].name, "a");
        assert_eq!(tools[0].server_id, "s");
    }

    #[test]
    fn reconnect_budget_is_capped() {
        // Pure-logic check: MAX_RECONNECTS constant bounds attempts.
        assert_eq!(MAX_RECONNECTS, 3);
        assert!(RECONNECT_BACKOFF <= Duration::from_secs(1));
    }
}
